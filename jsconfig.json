{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "strict": false
  },
  "include": ["src/**/*", "backend/**/*"],
  "exclude": ["node_modules", "dist", "backend/node_modules"]
}
