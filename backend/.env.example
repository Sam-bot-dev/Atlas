# Firebase Admin SDK (rotate the exposed key first!)
FIREBASE_PROJECT_ID=atlas-9de9c
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # Paste your full PEM key here (multiline or base64)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXXX@atlas-9de9c.iam.gserviceaccount.com

FRONTEND_URL=http://localhost:5173
